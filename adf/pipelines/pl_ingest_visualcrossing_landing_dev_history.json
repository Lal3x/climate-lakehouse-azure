{
  "name": "pl_ingest_VIsualCrossing_lading_dev_history",
  "properties": {
    "activities": [
      {
        "name": "web_get_api_key",
        "type": "WebActivity",
        "dependsOn": [],
        "policy": {
          "timeout": "0.12:00:00",
          "retry": 0,
          "retryIntervalInSeconds": 30,
          "secureOutput": true,
          "secureInput": true
        },
        "userProperties": [],
        "typeProperties": {
          "method": "GET",
          "url": {
            "value": "@concat(pipeline().parameters.keyVaultBaseUrl, '/secrets/visualcrossing-api-key-dev?api-version=2025-07-01')",
            "type": "Expression"
          },
          "authentication": {
            "type": "MSI",
            "resource": "https://vault.azure.net/"
          }
        }
      },
      {
        "name": "Set_Date_list",
        "type": "SetVariable",
        "dependsOn": [
          {
            "activity": "web_get_api_key",
            "dependencyConditions": [
              "Succeeded"
            ]
          }
        ],
        "policy": {
          "secureOutput": false,
          "secureInput": false
        },
        "userProperties": [],
        "typeProperties": {
          "variableName": "date_list",
          "value": {
            "value": "@range(0, add(1, div(sub(ticks(pipeline().parameters.ended_date), ticks(pipeline().parameters.started_date)), 864000000000)))",
            "type": "Expression"
          }
        }
      },
      {
        "name": "ForEach_date",
        "type": "ForEach",
        "dependsOn": [
          {
            "activity": "Set_Date_list",
            "dependencyConditions": [
              "Succeeded"
            ]
          }
        ],
        "userProperties": [],
        "typeProperties": {
          "items": {
            "value": "@variables('date_list')",
            "type": "Expression"
          },
          "batchCount": 10,
          "activities": [
            {
              "name": "copy_visualCrosssing_ to_landing",
              "description": "Copia dados da origem para storage",
              "type": "Copy",
              "dependsOn": [],
              "policy": {
                "timeout": "0.12:00:00",
                "retry": 0,
                "retryIntervalInSeconds": 30,
                "secureOutput": false,
                "secureInput": false
              },
              "userProperties": [],
              "typeProperties": {
                "source": {
                  "type": "JsonSource",
                  "storeSettings": {
                    "type": "HttpReadSettings",
                    "requestMethod": "GET"
                  },
                  "formatSettings": {
                    "type": "JsonReadSettings"
                  }
                },
                "sink": {
                  "type": "JsonSink",
                  "storeSettings": {
                    "type": "AzureBlobFSWriteSettings"
                  },
                  "formatSettings": {
                    "type": "JsonWriteSettings"
                  }
                },
                "enableStaging": false
              },
              "inputs": [
                {
                  "referenceName": "ds_json_visualcrossing_src_dev",
                  "type": "DatasetReference",
                  "parameters": {
                    "citty": {
                      "value": "@pipeline().parameters.city",
                      "type": "Expression"
                    },
                    "date": {
                      "value": "@formatDateTime(addDays(pipeline().parameters.started_date, \n    item()), 'yyyy-MM-dd'\n)",
                      "type": "Expression"
                    },
                    "apiKey": {
                      "value": "@activity('web_get_api_key').output.value",
                      "type": "Expression"
                    }
                  }
                }
              ],
              "outputs": [
                {
                  "referenceName": "ds_json_visualcrossing_landing_dev",
                  "type": "DatasetReference",
                  "parameters": {
                    "city": {
                      "value": "@pipeline().parameters.city",
                      "type": "Expression"
                    },
                    "date": {
                      "value": "@formatDateTime(addDays(pipeline().parameters.started_date, \n    item()), 'yyyy-MM-dd'\n)",
                      "type": "Expression"
                    },
                    "file_name": {
                      "value": "@concat(\n    'climate_',\n    pipeline().parameters.city, '_', formatDateTime(utcNow(), 'yyyyMMddHHmmss'), '.json'\n)",
                      "type": "Expression"
                    }
                  }
                }
              ]
            }
          ]
        }
      }
    ],
    "parameters": {
      "city": {
        "type": "string"
      },
      "started_date": {
        "type": "string"
      },
      "ended_date": {
        "type": "string"
      },
      "keyVaultBaseUrl": {
        "type": "string",
        "defaultValue": "https://<key-vault-name>.vault.azure.net"
      }
    },
    "variables": {
      "date": {
        "type": "String"
      },
      "date_list": {
        "type": "Array"
      }
    },
    "folder": {
      "name": "VisualCrossing"
    },
    "annotations": []
  }
}
